class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def authorized(self):
        header = self.headers.get("Authorization", "")
        expected = "Basic " + base64.b64encode(f"{USERNAME}:{PASSWORD}".encode()).decode()
        return header == expected

    def require_auth(self):
        self.send_response(HTTPStatus.UNAUTHORIZED)
        self.send_header("WWW-Authenticate", 'Basic realm="Xray Users"')
        self.end_headers()

    def send_html(self, content, status=HTTPStatus.OK):
        payload = content.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        if not self.authorized():
            self.require_auth()
            return
        if self.path in ("/", "/index.html"):
            self.send_html(page())
            return
        self.send_error(HTTPStatus.NOT_FOUND)

    def do_POST(self):
        if not self.authorized():
            self.require_auth()
            return
        length = int(self.headers.get("Content-Length", "0"))
        form = parse_form(self.rfile.read(length))
        try:
            clients = load_clients()
            if self.path == "/add":
                client_id = form.get("id", "").strip() or str(uuid.uuid4())
                uuid.UUID(client_id)
                email = form.get("email", "").strip()
                if any(client["id"] == client_id for client in clients):
                    raise RuntimeError("Client UUID already exists")
                clients.append({"id": client_id, "flow": XRAY_DEFAULT_FLOW, "email": email})
                save_clients_and_reload(clients)
                self.send_html(page(message="User added and Xray restarted."))
                return
            if self.path == "/delete":
                client_id = form.get("id", "").strip()
                updated = [client for client in clients if client["id"] != client_id]
                if len(updated) == len(clients):
                    raise RuntimeError("Client UUID not found")
                if not updated:
                    raise RuntimeError("Refusing to delete the last Xray client")
                save_clients_and_reload(updated)
                self.send_html(page(message="User deleted and Xray restarted."))
                return
            self.send_error(HTTPStatus.NOT_FOUND)
        except Exception as error:
            self.send_html(page(error=str(error)), status=HTTPStatus.BAD_REQUEST)


if __name__ == "__main__":
    ThreadingHTTPServer((LISTEN_ADDRESS, PORT), Handler).serve_forever()
