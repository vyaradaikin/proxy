      {message_html}
      {error_html}
    </section>
    <section>
      <h2>Users</h2>
      <div class="card">
        <table>
          <thead><tr><th>User</th><th>Flow</th><th>VLESS Reality URL</th><th></th></tr></thead>
          <tbody>{rows_html}</tbody>
