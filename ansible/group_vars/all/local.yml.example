---
# Copy to ansible/group_vars/all/local.yml and set environment-specific values.

wg_interface: wg0

common_apt_manage_force_ipv4: false
common_apt_force_ipv4: true

wg_ru_ip: 10.100.0.2
wg_non_ru_ip: 10.100.0.1
wg_network: 10.100.0.0/24

wg_port: 51820
wg_mtu: 1380

wg_speedtest_enabled: true
wg_speedtest_port: 5201
wg_speedtest_duration: 10
wg_speedtest_parallel: 1
wg_speedtest_reverse: true

wg_transport: direct
wg_udp2raw_install: true
wg_udp2raw_download_url: https://github.com/wangyu-/udp2raw-tunnel/releases/latest/download/udp2raw_binaries.tar.gz
wg_udp2raw_local_port: 51821
wg_udp2raw_public_port: 4433
wg_udp2raw_raw_mode: faketcp
wg_udp2raw_mtu: 1200
wg_udp2raw_extra_args:
  - --fix-gro

ru_public_ip: 203.0.113.10
non_ru_public_ip: 198.51.100.10
non_ru_external_interface: eth0

xray_dest: example.com:443
xray_sni: example.com
xray_sniffing_enabled: true
xray_sniffing_dest_override:
  - http
  - tls
  - quic
xray_sniffing_route_only: false
xray_client_dns_direct_enabled: true
xray_client_dns_direct_ports: "53,853"
xray_client_encrypted_dns_direct_enabled: true
xray_client_encrypted_dns_domains:
  - dns.google
  - dns64.dns.google
  - cloudflare-dns.com
  - one.one.one.one
  - security.cloudflare-dns.com
  - family.cloudflare-dns.com
  - dns.quad9.net
  - dns.adguard-dns.com
  - unfiltered.adguard-dns.com
xray_client_encrypted_dns_ips:
  - 8.8.8.8/32
  - 8.8.4.4/32
  - 1.1.1.1/32
  - 1.0.0.1/32
  - 9.9.9.9/32
  - 149.112.112.112/32
# Extend these lists if a local service still resolves outside the built-in
# RU geosite/geoip datasets but must leave through the RU gateway directly.
xray_ru_domains:
  - geosite:category-ru
  - geosite:yandex
  - domain:ya.ru
  - domain:yandex.ru
  - domain:yandex.net
  - domain:yastatic.net
  - domain:yastat.net
  - domain:cdn.yandex.net
  - domain:internetometr.download.cdn.yandex.net
  - domain:strm.yandex.ru
  - regexp:.*\.ru$
  - regexp:.*\.su$
  - regexp:.*\.xn--p1ai$
xray_ru_ips:
  - geoip:ru
  - geoip:private
xray_user_ui_enabled: false
xray_user_ui_basic_auth_user: admin
xray_user_backup_enabled: false
xray_user_backup_root: /backup/xray-users
xray_user_backup_interval: daily

monitoring_server_hosts: non_ru
monitoring_server_enabled: false
monitoring_exporter_enabled: false
monitoring_telegram_enabled: false
# For a dedicated monitoring VM, allow node_exporter scrapes only from it.
monitoring_scrape_source_ips: []
monitoring_public_enabled: false
monitoring_public_domain: monitoring.example.com
monitoring_public_letsencrypt_email: admin@example.com
monitoring_public_basic_auth_user: admin

routing_table: wgexit
routing_table_id: 100
routing_mark: 100
routing_ru_service_egress_enabled: false
routing_ru_service_egress_tcp_ports:
  - 80
  - 443
  - 53
routing_ru_service_egress_udp_ports:
  - 53
  - 123
routing_ru_service_egress_excluded_users:
  - "{{ xray_user }}"
routing_ru_service_egress_excluded_ipv4_cidrs:
  - 0.0.0.0/8
  - 10.0.0.0/8
  - 100.64.0.0/10
  - 127.0.0.0/8
  - 169.254.0.0/16
  - 172.16.0.0/12
  - 192.0.2.0/24
  - 192.168.0.0/16
  - 198.51.100.0/24
  - 203.0.113.0/24
  - 224.0.0.0/4
  - 240.0.0.0/4
routing_ru_service_egress_excluded_ipv4_addresses:
  - "{{ ru_public_ip }}"
  - "{{ non_ru_public_ip }}"
  - "{{ wg_ru_ip }}"
  - "{{ wg_non_ru_ip }}"

dns_non_ru_forwarder_enabled: false
dns_non_ru_bind_ip: "{{ wg_non_ru_ip }}"
dns_non_ru_listen_port: 53
dns_non_ru_filter_aaaa: true
dns_ru_split_forwarder_enabled: false
dns_ru_split_bind_ip: 127.0.0.1
dns_ru_split_listen_port: 53
dns_ru_split_filter_aaaa: true
dns_ru_split_default_upstreams:
  - "{{ wg_non_ru_ip }}"
dns_ru_split_local_upstreams:
  - 77.88.8.8
  - 77.88.8.1
dns_ru_split_local_zones:
  - ru
  - su
  - xn--p1ai
  - yandex.ru
  - ya.ru
  - yandex.net
  - yastatic.net
  - yastat.net
  - yandex-team.ru
dns_ru_intercept_xray_dns_enabled: false
dns_ru_intercept_xray_dns_ports:
  - 53
dns_ru_manage_resolv_conf: false
dns_ru_nameservers:
  - "{{ wg_non_ru_ip }}"
dns_ru_search_domains: []
dns_ru_resolv_options:
  - timeout:2
  - attempts:3

firewall_ru_extra_tcp_ports: []
firewall_ru_extra_udp_ports: []
firewall_non_ru_extra_tcp_ports: []
firewall_non_ru_extra_udp_ports: []
