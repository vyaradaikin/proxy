[Unit]
Description=Xray Service
Documentation=https://github.com/xtls
After=network.target nss-lookup.target {{ "wg-quick@" ~ wg_interface ~ ".service" if wg_interface is defined else "" }}
Wants={{ "wg-quick@" ~ wg_interface ~ ".service" if wg_interface is defined else "" }}

[Service]
User={{ xray_user }}
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart={{ xray_binary_path }} run -config {{ xray_config_path }}
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000
RuntimeDirectory=xray
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
