server {
  listen 80;
  server_name {{ monitoring_public_domain }};

  location /.well-known/acme-challenge/ {
    root {{ monitoring_public_acme_root }};
  }

{% if monitoring_public_tls_enabled | bool and monitoring_public_certificate_exists | bool %}
  location / {
    return 301 https://$host$request_uri;
  }
{% else %}
  location / {
    auth_basic "Proxy Monitoring";
    auth_basic_user_file {{ monitoring_public_htpasswd_path }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://{{ monitoring_ui_listen_address }}:{{ monitoring_ui_port }};
  }
{% endif %}
}

{% if monitoring_public_tls_enabled | bool and monitoring_public_certificate_exists | bool %}
server {
  listen 443 ssl http2;
  server_name {{ monitoring_public_domain }};

  ssl_certificate /etc/letsencrypt/live/{{ monitoring_public_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ monitoring_public_domain }}/privkey.pem;
  ssl_session_cache shared:proxy_monitoring_ssl:10m;
  ssl_session_timeout 1d;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  location / {
    auth_basic "Proxy Monitoring";
    auth_basic_user_file {{ monitoring_public_htpasswd_path }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://{{ monitoring_ui_listen_address }}:{{ monitoring_ui_port }};
  }
}
{% endif %}
