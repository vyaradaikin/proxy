#!/usr/bin/env python3
{% raw %}
import base64
import html
import json
import os
import shutil
import subprocess
import tempfile
import time
import urllib.parse
import uuid
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


LISTEN_ADDRESS = os.environ.get("UI_LISTEN_ADDRESS", "127.0.0.1")
PORT = int(os.environ.get("UI_PORT", "19095"))
USERNAME = os.environ.get("UI_USERNAME", "admin")
PASSWORD = os.environ.get("UI_PASSWORD", "")
XRAY_CONFIG_PATH = os.environ.get("XRAY_CONFIG_PATH", "/usr/local/etc/xray/config.json")
XRAY_CLIENTS_PATH = os.environ.get("XRAY_CLIENTS_PATH", "/usr/local/etc/xray/clients.json")
XRAY_BINARY_PATH = os.environ.get("XRAY_BINARY_PATH", "/usr/local/bin/xray")
XRAY_PUBLIC_HOST = os.environ.get("XRAY_PUBLIC_HOST", "")
XRAY_PORT = os.environ.get("XRAY_PORT", "443")
XRAY_SNI = os.environ.get("XRAY_SNI", "")
XRAY_PUBLIC_KEY = os.environ.get("XRAY_PUBLIC_KEY", "")
XRAY_SHORT_ID = os.environ.get("XRAY_SHORT_ID", "")
XRAY_DEFAULT_FLOW = os.environ.get("XRAY_DEFAULT_FLOW", "xtls-rprx-vision")
XRAY_FINGERPRINT = os.environ.get("XRAY_FINGERPRINT", "chrome")
XRAY_CONFIG_MODE = 0o644
XRAY_CLIENTS_MODE = 0o600


def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as stream:
            return json.load(stream)
    except FileNotFoundError:
        return default


def atomic_write_json(path, payload, mode=0o600):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2)
            stream.write("\n")
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)


def normalize_clients(clients):
    normalized = []
    seen = set()
    for client in clients:
        client_id = str(client.get("id", "")).strip()
        if not client_id or client_id in seen:
            continue
        seen.add(client_id)
        item = {"id": client_id}
        flow = str(client.get("flow", XRAY_DEFAULT_FLOW)).strip()
        email = str(client.get("email", "")).strip()
        if flow:
            item["flow"] = flow
        if email:
            item["email"] = email
        normalized.append(item)
    return normalized


def load_clients():
    return normalize_clients(load_json(XRAY_CLIENTS_PATH, []))


def save_clients_and_reload(clients):
    clients = normalize_clients(clients)
    config = load_json(XRAY_CONFIG_PATH, {})
    inbounds = config.setdefault("inbounds", [])
    if not inbounds:
        raise RuntimeError("Xray config has no inbounds")
    settings = inbounds[0].setdefault("settings", {})
    settings["clients"] = clients

    directory = os.path.dirname(XRAY_CONFIG_PATH)
    fd, tmp_config = tempfile.mkstemp(prefix=".xray-config-", suffix=".json", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(config, stream, indent=2)
            stream.write("\n")
        os.chmod(tmp_config, XRAY_CONFIG_MODE)
        subprocess.run([XRAY_BINARY_PATH, "run", "-test", "-config", tmp_config], check=True, capture_output=True, text=True)
        backup_path = XRAY_CONFIG_PATH + ".before-user-ui-" + time.strftime("%Y%m%d%H%M%S")
        shutil.copy2(XRAY_CONFIG_PATH, backup_path)
        os.replace(tmp_config, XRAY_CONFIG_PATH)
        atomic_write_json(XRAY_CLIENTS_PATH, clients, XRAY_CLIENTS_MODE)
        subprocess.run(["systemctl", "restart", "xray"], check=True, capture_output=True, text=True)
    finally:
        if os.path.exists(tmp_config):
            os.unlink(tmp_config)


def reality_link(client):
    client_id = urllib.parse.quote(client["id"])
    label = urllib.parse.quote(client.get("email") or client["id"])
    params = {
        "type": "tcp",
        "security": "reality",
        "pbk": XRAY_PUBLIC_KEY,
        "fp": XRAY_FINGERPRINT,
        "sni": XRAY_SNI,
        "sid": XRAY_SHORT_ID,
    }
    if client.get("flow"):
        params["flow"] = client["flow"]
    query = urllib.parse.urlencode(params)
    return f"vless://{client_id}@{XRAY_PUBLIC_HOST}:{XRAY_PORT}?{query}#{label}"


def parse_form(body):
    return {key: values[-1] for key, values in urllib.parse.parse_qs(body.decode("utf-8")).items()}


def page(message="", error=""):
    clients = load_clients()
    rows = []
    for client in clients:
        link = reality_link(client)
        rows.append(f"""
          <tr>
            <td><strong>{html.escape(client.get("email", ""))}</strong><div class="muted">{html.escape(client["id"])}</div></td>
            <td>{html.escape(client.get("flow", ""))}</td>
            <td><input readonly value="{html.escape(link)}" onclick="this.select()"></td>
            <td>
              <form method="post" action="/delete">
                <input type="hidden" name="id" value="{html.escape(client["id"])}">
                <button class="danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        """)
    rows_html = "\n".join(rows) if rows else '<tr><td colspan="4" class="muted">No clients configured.</td></tr>'
    message_html = f'<div class="notice ok">{html.escape(message)}</div>' if message else ""
    error_html = f'<div class="notice bad">{html.escape(error)}</div>' if error else ""
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Xray Users</title>
